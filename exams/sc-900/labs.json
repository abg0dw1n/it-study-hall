{
 "intro": "Practice SC-900 ideas with sorting activities and a Conditional Access policy builder.",
 "labs": [
  {
   "id": "sc900-identity",
   "title": "Identity and Zero Trust",
   "domain": "D2",
   "kind": "tasks",
   "level": "beginner",
   "minutes": 10,
   "summary": "Sort identity capabilities and put a Conditional Access flow in order.",
   "scenario": "<p>Show you know what each identity feature does.</p>",
   "activities": [
    {
     "type": "match",
     "title": "Feature to purpose",
     "prompt": "Match each scenario to the best feature.",
     "categories": [
      "Conditional Access",
      "PIM",
      "Access reviews",
      "SSPR",
      "ID Protection"
     ],
     "items": [
      {
       "text": "Require MFA only when a sign-in is from a new country",
       "cat": 0
      },
      {
       "text": "Make an admin role active only for two hours after approval",
       "cat": 1
      },
      {
       "text": "Managers recertify who still needs group membership",
       "cat": 2
      },
      {
       "text": "Users reset forgotten passwords without the help desk",
       "cat": 3
      },
      {
       "text": "Detect a leaked-credentials risk on a user",
       "cat": 4
      }
     ]
    },
    {
     "type": "order",
     "title": "Conditional Access",
     "prompt": "Order the evaluation.",
     "items": [
      "User signs in",
      "Signals are collected",
      "Policy conditions are evaluated",
      "Grant controls are enforced",
      "Access is allowed or blocked"
     ]
    },
    {
     "type": "fill",
     "title": "Principles",
     "prompt": "Type each answer.",
     "rows": [
      {
       "label": "Zero Trust principle that limits permissions (two words, 'least ...')",
       "answer": [
        "least privilege"
       ],
       "placeholder": "least ..."
      },
      {
       "label": "Passwordless standard hardware key (acronym)",
       "answer": [
        "FIDO2"
       ],
       "placeholder": "..."
      },
      {
       "label": "Proving who you are",
       "answer": [
        "authentication"
       ],
       "placeholder": "..."
      }
     ]
    }
   ],
   "tasks": [
    {
     "text": "Feature to purpose",
     "check": {
      "activity": 0
     }
    },
    {
     "text": "Conditional Access",
     "check": {
      "activity": 1
     }
    },
    {
     "text": "Principles",
     "check": {
      "activity": 2
     }
    }
   ],
   "hints": [
    "Think about the trigger in each scenario.",
    "Policies evaluate before access is granted."
   ],
   "review": "<p>Conditional Access uses signals to decide; PIM and access reviews handle privileged access over time.</p>"
  },
  {
