  {
   "id": "sc900-ca-policy",
   "title": "Build a Conditional Access policy",
   "domain": "D2",
   "kind": "portal",
   "level": "intermediate",
   "minutes": 10,
   "summary": "Require MFA for administrators outside the office.",
   "scenario": "<p>Create policy <code>CA-Admins-MFA</code> that targets the <b>Admins</b> group on <b>All cloud apps</b>, applies when the location is <b>Any location except Corporate network</b>, and grants access only if <b>Multifactor authentication</b> is required. Turn the policy <b>On</b> and save.</p>",
   "portal": {
    "app": "Identity Admin Center",
    "address": "Protection › Conditional Access › New policy",
    "pages": [
     {
      "id": "pol",
      "title": "New policy",
      "sections": [
       {
        "title": "Name",
        "fields": [
         {
          "id": "name",
          "label": "Policy name",
          "type": "text",
          "value": ""
         }
        ]
       },
       {
        "title": "Assignments",
        "fields": [
         {
          "id": "users",
          "label": "Users or groups",
          "type": "select",
          "value": "All users",
          "options": [
           "All users",
           "Admins",
           "Finance",
           "Guests"
          ]
         },
         {
          "id": "apps",
          "label": "Target resources",
          "type": "select",
          "value": "Office 365",
          "options": [
           "Office 365",
           "All cloud apps",
           "Azure management"
          ]
         },
         {
          "id": "loc",
          "label": "Locations",
          "type": "select",
          "value": "Any location",
          "options": [
           "Any location",
           "Any location except Corporate network",
           "Corporate network only"
          ]
         }
        ]
       },
       {
        "title": "Access controls",
        "fields": [
         {
          "id": "grant",
          "label": "Grant",
          "type": "select",
          "value": "Allow access",
          "options": [
           "Allow access",
           "Require multifactor authentication",
           "Block access"
          ]
         },
         {
          "id": "state",
          "label": "Enable policy",
          "type": "select",
          "value": "Off",
          "options": [
           "Off",
           "Report-only",
           "On"
          ]
         }
        ]
       }
      ]
     }
    ]
   },
   "tasks": [
    {
     "text": "Named CA-Admins-MFA and targets Admins on all cloud apps",
     "check": {
      "all": [
       {
        "field": "pol.name",
        "eq": "CA-Admins-MFA"
       },
       {
        "field": "pol.users",
        "eq": "Admins"
       },
       {
        "field": "pol.apps",
        "eq": "All cloud apps"
       }
      ]
     }
    },
    {
     "text": "Applies outside the corporate network",
     "check": {
      "all": [
       {
        "field": "pol.loc",
        "eq": "Any location except Corporate network"
       }
      ]
     }
    },
    {
     "text": "Requires MFA and is On",
     "check": {
      "all": [
       {
        "field": "pol.grant",
        "eq": "Require multifactor authentication"
       },
       {
        "field": "pol.state",
        "eq": "On"
       }
      ]
     }
    }
   ],
   "hints": [
    "Report-only evaluates but does not enforce.",
    "Exclude the corporate network by choosing the 'except' location option."
   ],
   "review": "<p>Conditional Access combines assignments (who, what, where) with access controls. Report-only mode is useful for testing before enforcing.</p>"
  }
 ]
}