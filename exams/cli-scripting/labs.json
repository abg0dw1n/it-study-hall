        {
          "platform": "linux",
          "hostname": "ubuntu01",
          "ip": "10.0.0.21",
          "name": "ubuntu01",
          "users": {},
          "files": {
            "/var/log/webapp": {
              "dir": true,
              "owner": "root"
            },
