       "Reset password"
      ],
      [
       "Enable-ADAccount NAME / Disable-ADAccount NAME",
       "Enable / disable"
      ],
      [
       "Get-ADGroupMember GROUP",
       "List members"
      ],
      [
       "Add-ADGroupMember GROUP -Members NAME",
