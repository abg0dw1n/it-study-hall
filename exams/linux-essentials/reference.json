{
 "intro": "Printable beginner sheets for Linux Essentials: commands, permissions, users and the filesystem layout.",
 "trainer": false,
 "sheets": [
  {
   "id": "commands",
   "title": "Everyday commands",
   "blurb": "Files, text processing, redirection and the editor.",
   "blocks": [
    {
     "type": "cmds",
     "title": "Files and directories",
     "rows": [
      [
       "ls -lah  /  ls -ld dir",
       "List with details, hidden files, human sizes"
      ],
      [
       "cd -  /  pwd",
       "Previous directory; where am I"
      ],
      [
       "cp -a src dst  /  mv a b  /  rm -r dir",
       "Copy (keep attributes), move or rename, remove"
      ],
      [
       "mkdir -p a/b/c  /  rmdir",
       "Create parents; remove empty dir"
      ],
      [
       "touch file  /  stat file",
       "Create or update time; show inode details"
      ],
      [
       "ln file hard  /  ln -s target link",
       "Hard link / symbolic link"
      ],
      [
       "find /etc -name '*.conf' -mtime -7",
       "Search by name, age (`-size`, `-user`, `-perm`, `-type f`)"
      ],
      [
       "find / -perm -4000 -type f 2>/dev/null",
       "Find setuid files"
      ],
      [
       "locate name  /  updatedb",
       "Fast indexed search"
      ],
      [
       "file x  /  du -sh dir  /  df -h",
       "File type; directory size; free space"
      ],
      [
       "tar -czf a.tgz dir  /  tar -xzf a.tgz -C /tmp",
       "Create / extract gzip tar (`-j` bzip2, `-J` xz, `-t` list)"
      ],
      [
       "gzip / gunzip / zip / unzip",
       "Compression"
      ]
     ]
    },
    {
     "type": "cmds",
     "title": "Viewing, searching and editing text",
     "rows": [
      [
       "cat  /  less  /  head -n 5  /  tail -f log",
       "View; follow a growing file"
      ],
      [
       "grep -rin 'error' /var/log",
       "Search recursively, ignore case, line numbers (`-v` invert, `-E` regex, `-c` count)"
      ],
      [
       "sed 's/old/new/g' f  /  sed -i ... f",
       "Substitute; `-i` edits in place"
      ],
      [
       "awk '{print $1,$3}' f  /  awk -F: '{print $1}' /etc/passwd",
       "Columns; custom delimiter"
      ],
      [
       "cut -d: -f1 f  /  sort -n  /  uniq -c  /  wc -l",
       "Pieces; sort; count duplicates; count lines"
      ],
      [
       "tr a-z A-Z  /  tee file  /  xargs",
       "Translate; write and pass on; build commands"
      ],
      [
       "cmd > file  /  >> file  /  2> err  /  &> all  /  < in",
       "Redirection: overwrite, append, stderr, both, stdin"
      ],
      [
       "a | b  /  a && b  /  a || b  /  a ; b",
       "Pipe; run if success; run if failure; sequence"
      ],
      [
       "vim: i, Esc, :wq, :q!, /text, dd, yy, p, u",
       "Insert, save and quit, force quit, search, delete line, copy, paste, undo"
      ]
     ]
    }
   ]
  },
  {
   "id": "perms",
   "title": "Permissions and users",
   "blurb": "Permission bits, ownership, users, groups and sudo.",
   "blocks": [
    {
     "type": "table",
     "title": "Permissions",
     "head": [
      "Octal",
      "Symbolic",
      "Meaning"
     ],
     "rows": [
      [
       "7",
       "rwx",
       "Read, write, execute"
      ],
      [
       "6",
       "rw-",
       "Read, write"
      ],
      [
       "5",
       "r-x",
       "Read, execute"
      ],
      [
       "4",
       "r--",
       "Read"
      ],
      [
       "0",
       "---",
       "None"
      ]
     ]
    },
    {
     "type": "cmds",
     "title": "Ownership and special bits",
     "rows": [
      [
       "chmod 640 f  /  chmod u+x,g-w,o= f  /  chmod -R",
       "Octal or symbolic"
      ],
      [
       "chown user:group f  /  chown -R  /  chgrp",
       "Owner and group"
      ],
      [
       "umask 022",
       "Default mask: files 644, directories 755 (subtracted from 666 / 777)"
      ],
      [
       "chmod u+s f  /  chmod g+s dir  /  chmod +t dir",
       "setuid (4), setgid (2: new files inherit the group), sticky (1: only the owner can delete)"
      ],
      [
       "setfacl -m u:alice:rw f  /  getfacl f",
       "Access control lists"
      ],
      [
       "lsattr  /  chattr +i f",
       "Attributes; immutable flag"
      ]
     ]
    },
    {
     "type": "cmds",
     "title": "Users, groups and sudo",
     "rows": [
      [
       "useradd -m -s /bin/bash -G wheel alice",
       "Create user with home, shell, supplementary group (`-u`, `-g`, `-d`, `-e`)"
      ],
      [
       "usermod -aG docker alice",
       "Add to a group (without -a you replace the groups)"
      ],
      [
       "userdel -r alice",
       "Remove user and home"
      ],
      [
       "passwd alice  /  passwd -l  /  passwd -e",
       "Set, lock, expire password"
      ],
      [
       "chage -l alice  /  chage -M 90 alice",
       "Password aging"
      ],
      [
       "groupadd dev  /  gpasswd -a alice dev",
       "Groups"
      ],
      [
       "id  /  groups  /  who  /  w  /  last",
       "Identity and sessions"
      ],
      [
       "su - alice  /  sudo -u alice cmd  /  sudo -i",
       "Switch user, run as, root shell"
      ],
      [
       "visudo  /  /etc/sudoers.d/file",
       "Edit sudo rules safely; example `alice ALL=(ALL) NOPASSWD: /usr/bin/systemctl`"
      ]
     ]
    },
    {
     "type": "table",
     "title": "Account files",
     "head": [
      "File",
      "Holds"
     ],
     "rows": [
      [
       "/etc/passwd",
       "name:x:UID:GID:comment:home:shell (UID 0 = root, system accounts below 1000 on most distributions)"
      ],
      [
       "/etc/shadow",
       "Password hashes and aging (root only)"
      ],
      [
       "/etc/group",
       "Group names and members"
      ],
      [
       "/etc/login.defs  /  /etc/default/useradd  /  /etc/skel",
       "Defaults for new accounts"
      ],
      [
       "~/.bashrc  /  ~/.bash_profile  /  /etc/profile",
       "Shell startup files"
      ]
     ]
    }
   ]
  },
  {
   "id": "fhs",
   "title": "Filesystem and system",
   "blurb": "Directory layout, processes and system information.",
   "blocks": [
    {
     "type": "table",
     "title": "Filesystem Hierarchy",
     "head": [
      "Path",
      "Purpose"
     ],
     "rows": [
      [
       "/",
       "Root of the tree"
      ],
      [
       "/etc",
       "System configuration"
      ],
      [
       "/home  /  /root",
       "User homes; root's home"
      ],
      [
       "/var",
       "Variable data: /var/log, /var/spool, /var/lib, /var/tmp"
      ],
      [
       "/usr",
       "Programs and libraries (/usr/bin, /usr/sbin, /usr/local)"
      ],
      [
       "/bin  /  /sbin  /  /lib",
       "Essential binaries and libraries (symlinks to /usr on modern systems)"
      ],
      [
       "/boot",
       "Kernel, initramfs, bootloader"
      ],
      [
       "/dev",
       "Device files"
      ],
      [
       "/proc  /  /sys",
       "Kernel and process information (virtual)"
      ],
      [
       "/tmp",
       "Temporary files, cleared often"
      ],
      [
       "/opt",
       "Add-on software"
      ],
      [
       "/mnt  /  /media",
       "Temporary and removable mounts"
      ],
      [
       "/run",
       "Runtime data since boot"
      ],
      [
       "/srv",
       "Service data (web, FTP)"
      ]
     ]
    },
    {
     "type": "cmds",
     "title": "Processes and system",
     "rows": [
      [
       "ps aux  /  ps -ef  /  top  /  htop",
       "Process lists"
      ],
      [
       "kill PID  /  kill -9 PID  /  pkill name  /  killall",
       "SIGTERM (15) politely, SIGKILL (9) forcibly"
      ],
      [
       "nice -n 10 cmd  /  renice -n 5 -p PID",
       "Priority (-20 high to 19 low)"
      ],
      [
       "jobs  /  bg  /  fg  /  cmd &  /  nohup cmd &",
       "Job control"
      ],
      [
       "uname -a  /  uptime  /  free -h  /  lscpu  /  lsblk",
       "Kernel, load, memory, CPU, block devices"
      ],
      [
       "lsof -i :80  /  ss -tulpn",
       "What is using a file or port"
      ],
      [
       "journalctl -xe  /  dmesg",
       "Recent errors; kernel messages"
      ],
      [
       "date  /  timedatectl  /  hostnamectl",
       "Time, time zone, hostname"
      ],
      [
       "man cmd  /  cmd --help  /  info  /  apropos word  /  whatis",
       "Documentation"
      ]
     ]
    }
   ]
  },
  {
   "id": "network",
   "title": "Networking and packages",
   "blurb": "Interface setup, DNS, firewall and package managers.",
   "blocks": [
    {
     "type": "cmds",
     "title": "Networking",
     "rows": [
      [
       "ip addr  /  ip link  /  ip route  /  ip -s link",
       "Addresses, links, routes, counters"
      ],
      [
       "nmcli con show  /  nmcli dev status",
       "NetworkManager connections and devices"
      ],
      [
       "nmcli con add type ethernet ifname eth0 con-name lan ipv4.method manual ipv4.addresses 192.168.1.10/24 ipv4.gateway 192.168.1.1 ipv4.dns 8.8.8.8",
       "Static address"
      ],
      [
       "nmcli con mod lan +ipv4.dns 1.1.1.1  /  nmcli con up lan",
       "Change and apply a connection"
      ],
      [
       "hostnamectl set-hostname name",
       "Persistent hostname"
      ],
      [
       "ping -c 4 host  /  traceroute  /  mtr",
       "Reachability and path"
      ],
      [
       "ss -tulpn  /  curl -I url  /  wget url",
       "Sockets; HTTP tests; download"
      ],
      [
       "dig name  /  host name  /  getent hosts name",
       "DNS tests (resolver config in /etc/resolv.conf, /etc/hosts, /etc/nsswitch.conf)"
      ],
      [
       "ssh user@host  /  ssh-keygen  /  ssh-copy-id  /  scp  /  rsync -av",
       "Remote access and copy"
      ]
     ]
    },
    {
     "type": "cmds",
     "title": "firewalld (RHEL) and ufw (Ubuntu)",
     "rows": [
      [
       "firewall-cmd --state  /  --get-active-zones",
       "Status and zones"
      ],
      [
       "firewall-cmd --add-service=http --permanent",
       "Allow a service (permanent)"
      ],
      [
       "firewall-cmd --add-port=8080/tcp --permanent",
       "Allow a port"
      ],
      [
       "firewall-cmd --reload",
       "Apply permanent changes"
      ],
      [
       "firewall-cmd --list-all",
       "Show the zone's rules"
      ],
      [
       "ufw allow 22/tcp  /  ufw enable  /  ufw status",
       "Ubuntu firewall"
      ]
     ]
    },
    {
     "type": "table",
     "title": "Package managers",
     "head": [
      "Task",
      "RHEL / Fedora (dnf, rpm)",
      "Debian / Ubuntu (apt, dpkg)"
     ],
     "rows": [
      [
       "Install",
       "dnf install pkg",
       "apt install pkg"
      ],
      [
       "Remove",
       "dnf remove pkg",
       "apt remove pkg  (purge to drop configs)"
      ],
      [
       "Update all",
       "dnf upgrade",
       "apt update && apt upgrade"
      ],
      [
       "Search",
       "dnf search word",
       "apt search word"
      ],
      [
       "Info",
       "dnf info pkg",
       "apt show pkg"
      ],
      [
       "Which package owns a file",
       "rpm -qf /path  /  dnf provides /path",
       "dpkg -S /path"
      ],
      [
       "List installed",
       "rpm -qa",
       "dpkg -l"
      ],
      [
       "Local file",
       "rpm -ivh x.rpm  /  dnf install ./x.rpm",
       "dpkg -i x.deb"
      ],
      [
       "Repositories",
       "/etc/yum.repos.d/*.repo",
       "/etc/apt/sources.list(.d)"
      ]
     ]
    }
   ]
  }
 ]
}