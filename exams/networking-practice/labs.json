        {
          "type": "order",
          "title": "DHCP: DORA",
          "prompt": "Put the DHCP exchange in order.",
          "items": [
            "Client broadcasts a Discover",
            "Server sends an Offer",
            "Client sends a Request",
            "Server sends an Acknowledgement"
